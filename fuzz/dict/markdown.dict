# libFuzzer dictionary for the Markdown targets (md_to_adf, roundtrip).
# Format: one quoted token per line; \\ \" and \xNN escapes. See https://llvm.org/docs/LibFuzzer.html#dictionaries

# Line structure
nl="\x0a"
blank="\x0a\x0a"
crlf="\x0d\x0a"
tab="\x09"
bom="\xef\xbb\xbf"
nul="\x00"
indent4="    "

# Headings and breaks
h1="# "
h6="###### "
setext1="\x0a===\x0a"
setext2="\x0a---\x0a"
rule_dash="---"
rule_star="***"
rule_under="___"
hard_spaces="  \x0a"
hard_backslash="\\\x0a"

# Emphasis and code
em="*"
strong="**"
both="***"
em_under="_"
strong_under="__"
strike="~~"
strike_single="~"
code="`"
code_double="``"
fence="```"
fence_tilde="~~~"
fence_long="````"
fence_adf="```adf\x0a"
fence_rust="```rust\x0a"

# Containers
quote="> "
quote_nested="> > "
bullet="- "
bullet_star="* "
bullet_plus="+ "
ordered="1. "
ordered_paren="1) "
ordered_big="123456789. "
task_open="- [ ] "
task_done="- [x] "
task_done_upper="- [X] "
indent2="  "

# Tables
pipe="|"
row="| a | b |\x0a"
delim="|---|---|\x0a"
align_center=":---:"
align_right="---:"
escaped_pipe="\\|"

# Links and images
link_open="["
link_mid="]("
link_close=")"
image="!["
ref_def="]: "
autolink_open="<https://"
http="http://"
https="https://"
www="www."
mailto="mailto:"
tel="tel:"
javascript="javascript:"
escaped_scheme="https\\://"
email="a@example.com"
footnote_ref="[^1]"
footnote_def="[^1]: "

# Escapes and entities
escape_star="\\*"
escape_backslash="\\\\"
amp="&amp;"
entity_space="&#32;"
entity_newline="&#10;"
entity_hex="&#x41;"
entity_open="&#"
nbsp="&nbsp;"

# HTML
br="<br>"
br_self="<br/>"
u_open="<u>"
u_close="</u>"
ins="<ins>"
del="<del>"
strike_tag="<strike>"
b_tag="<b>"
strong_tag="<strong>"
i_tag="<i>"
em_tag="<em>"
sub="<sub>"
sup="<sup>"
kbd="<kbd>"
span_color="<span style=\"color: #ff5630\">"
span_bg="<span style=\"background-color: #e3fcef\">"
span_close="</span>"
comment_open="<!--"
comment_close="-->"
div="<div>"
script="<script>"
details_open="<details>"
details_close="</details>"
summary_open="<summary>"
summary_close="</summary>"

# ADF extensions
alert_note="> [!NOTE]\x0a"
alert_tip="[!TIP]"
alert_important="[!IMPORTANT]"
alert_warning="[!WARNING]"
alert_caution="[!CAUTION]"
cell_open="::: cell\x0a"
cell_close=":::\x0a"
cell_long=":::: cell\x0a"
adf_mention="](adf:mention/"
adf_status="](adf:status/green)"
adf_status_bad="](adf:status/orange)"
adf_date="](adf:date)"
adf_emoji="](adf:emoji/:smile:)"
adf_card="](adf:card)"
adf_unknown="](adf:widget/"

# Front matter
front_matter="---\x0atitle: x\x0a---\x0a"

# Raw ADF JSON
json_doc="{\"type\":\"doc\",\"version\":1,\"content\":[]}"
json_panel="{\"type\":\"panel\",\"attrs\":{\"panelType\":\"info\"},\"content\":[{\"type\":\"paragraph\"}]}"
json_type="\"type\":"
json_content="\"content\":["
json_attrs="\"attrs\":{"
json_text="{\"type\":\"text\",\"text\":\"x\"}"
json_marks="\"marks\":[{\"type\":\"code\"}]"

# Unicode
emoji="\xf0\x9f\x98\x84"
zwj="\xe2\x80\x8d"
variation_selector="\xef\xb8\x8f"
line_separator="\xe2\x80\xa8"
replacement="\xef\xbf\xbd"
